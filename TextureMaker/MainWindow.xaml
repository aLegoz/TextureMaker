<Window x:Class="TextureMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TextureMaker.Views.Controls"
        Title="TextureMaker" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New"        Click="NewProject_Click"   InputGestureText="Ctrl+N"/>
                <MenuItem Header="Open..."    Click="OpenProject_Click"  InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="Save"       Click="SaveProject_Click"  InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save As..." Click="SaveAsProject_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Label FontWeight="Bold">Sources:</Label>
                <Button Click="AddNode_Click" Tag="RootFolder">Root Folder</Button>
                <Button Click="AddNode_Click" Tag="ImageLoad">Image Load</Button>
                <Button Click="AddNode_Click" Tag="SolidColor">Solid Color</Button>
                <Button Click="AddNode_Click" Tag="Gradient">Gradient</Button>
                <Button Click="AddNode_Click" Tag="Noise">Noise</Button>
                <Separator/>
                <Label FontWeight="Bold">Filters:</Label>
                <Button Click="AddNode_Click" Tag="Blur">Blur</Button>
                <Button Click="AddNode_Click" Tag="Sharpen">Sharpen</Button>
                <Button Click="AddNode_Click" Tag="BrightnessContrast">Brightness/Contrast</Button>
                <Separator/>
                <Label FontWeight="Bold">Combine:</Label>
                <Button Click="AddNode_Click" Tag="Blend">Blend</Button>
                <Button Click="AddNode_Click" Tag="Mask">Mask</Button>
                <Button Click="AddNode_Click" Tag="Composite">Composite</Button>
                <Separator/>
                <Label FontWeight="Bold">Special:</Label>
                <Button Click="AddNode_Click" Tag="NormalMap">Normal Map</Button>
                <Button Click="AddNode_Click" Tag="Invert">Invert</Button>
                <Button Click="AddNode_Click" Tag="Levels">Levels</Button>
                <Separator/>
                <Label FontWeight="Bold">Output:</Label>
                <Button Click="AddNode_Click" Tag="Save">Save</Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="StatusText">Ready — click a node to preview it</TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content: full-width canvas + floating preview card -->
        <Grid>
            <controls:GraphCanvas x:Name="NodeGraph"/>

            <Canvas x:Name="FloatCanvas">
                <Border x:Name="FloatCard"
                        Canvas.Left="100" Canvas.Top="60"
                        Width="360" Height="400"
                        MinWidth="200" MinHeight="150"
                        Background="#3C3F41"
                        BorderBrush="#555" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <!-- Node-style header (drag to move) -->
                        <Border Grid.Row="0"
                                Background="#1E1E1E"
                                Padding="6,4"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="FloatHeader_MouseDown"
                                MouseMove="FloatHeader_MouseMove"
                                MouseLeftButtonUp="FloatHeader_MouseUp">
                            <TextBlock Text="PREVIEW"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Preview content -->
                        <controls:PreviewPanel x:Name="FloatPreviewPanel" Grid.Row="1"/>

                        <!-- Resize grip -->
                        <Thumb Grid.Row="2"
                               Width="14" HorizontalAlignment="Right"
                               Cursor="SizeNWSE"
                               DragDelta="ResizeThumb_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Canvas Width="12" Height="12" Margin="0,1,1,0">
                                        <Line X1="2"  Y1="12" X2="12" Y2="2"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="6"  Y1="12" X2="12" Y2="6"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="10" Y1="12" X2="12" Y2="10" Stroke="#666" StrokeThickness="1.5"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
