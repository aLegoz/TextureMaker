<Window x:Class="TextureMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:controls="clr-namespace:TextureMaker.Views.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="TextureMaker" Height="700" Width="1200"
        Background="#1E1E1E"
        Icon="Resources/TextureMaker.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown"
        FontSize="12"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- Node creation button: icon + label, hover highlight -->
        <Style x:Key="NodeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3C3C42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#515158"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- File panel button: flat text style, like a menu bar item -->
        <Style x:Key="FileMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3C3C42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#515158"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootPanel" Background="#252526">

        <!-- ── File panel ──────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                Padding="4,3">
            <DockPanel>
                <!-- File actions -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FileMenuBtn}" Content="New"        ToolTip="New (Ctrl+N)"  Click="NewProject_Click"/>
                    <Button Style="{StaticResource FileMenuBtn}" Content="Open…"      ToolTip="Open (Ctrl+O)" Click="OpenProject_Click"/>
                    <Button Style="{StaticResource FileMenuBtn}" Content="Save"       ToolTip="Save (Ctrl+S)" Click="SaveProject_Click"/>
                    <Button Style="{StaticResource FileMenuBtn}" Content="Save As…"   ToolTip="Save As…"      Click="SaveAsProject_Click"/>
                    <Rectangle Width="1" Height="16" Fill="#3A3A3A" Margin="4,0"/>
                    <Button Style="{StaticResource FileMenuBtn}" Content="Export All" ToolTip="Export all Save nodes" Click="ExportAll_Click"/>
                    <Rectangle Width="1" Height="16" Fill="#3A3A3A" Margin="4,0"/>
                </StackPanel>
                <!-- Current file name -->
                <TextBlock x:Name="FileNameText"
                           Text="New Project"
                           Foreground="#666"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ── Nodes toolbar ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D2D"
                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                Padding="6,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- ── SOURCES ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="RootFolder" Click="AddNode_Click" ToolTip="Root Folder">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.RootFolder}"/>
                                <TextBlock Text="Root Folder" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="ImageLoad" Click="AddNode_Click" ToolTip="Image Load">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.ImageLoad}"/>
                                <TextBlock Text="Image Load" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Color" Click="AddNode_Click" ToolTip="Color">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Color}"/>
                                <TextBlock Text="Color" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="SolidColor" Click="AddNode_Click" ToolTip="Solid Color">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.SolidColor}"/>
                                <TextBlock Text="Solid Color" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Gradient" Click="AddNode_Click" ToolTip="Gradient">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Gradient}"/>
                                <TextBlock Text="Gradient" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Noise" Click="AddNode_Click" ToolTip="Noise">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Noise}"/>
                                <TextBlock Text="Noise" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Toggle" Click="AddNode_Click" ToolTip="Toggle (bool source)">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Toggle}"/>
                                <TextBlock Text="Toggle" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="SOURCES" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="56" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── FILTERS ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="Blur" Click="AddNode_Click" ToolTip="Blur">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Blur}"/>
                                <TextBlock Text="Blur" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Sharpen" Click="AddNode_Click" ToolTip="Sharpen">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Sharpen}"/>
                                <TextBlock Text="Sharpen" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="BrightnessContrast" Click="AddNode_Click" ToolTip="Brightness / Contrast">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.BrightnessContrast}"/>
                                <TextBlock Text="Brightness Contrast" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="FILTERS" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="56" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── COMBINE ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="Blend" Click="AddNode_Click" ToolTip="Blend">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Blend}"/>
                                <TextBlock Text="Blend" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Mask" Click="AddNode_Click" ToolTip="Mask">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Mask}"/>
                                <TextBlock Text="Mask" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Composite" Click="AddNode_Click" ToolTip="Composite">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Composite}"/>
                                <TextBlock Text="Composite" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="COMBINE" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="56" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── SPECIAL ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="NormalMap" Click="AddNode_Click" ToolTip="Normal Map">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.NormalMap}"/>
                                <TextBlock Text="Normal Map" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Invert" Click="AddNode_Click" ToolTip="Invert">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Invert}"/>
                                <TextBlock Text="Invert" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Levels" Click="AddNode_Click" ToolTip="Levels">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Levels}"/>
                                <TextBlock Text="Levels" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Switch" Click="AddNode_Click" ToolTip="Switch (route by condition)">
                            <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.Switch}"/>
                                <TextBlock Text="Switch" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="SPECIAL" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="56" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── OUTPUT ───────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <Button Style="{StaticResource NodeBtn}" Tag="Save" Click="AddNode_Click" ToolTip="Save Texture">
                        <Grid Width="56"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                            <Image Grid.Row="0" Width="26" Height="26" VerticalAlignment="Center" Source="{StaticResource Icon.SaveTexture}"/>
                            <TextBlock Text="Save" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Button>
                    <TextBlock Text="OUTPUT" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="StatusText">Ready — click a node to preview it</TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar x:Name="ExportProgress"
                             Width="150" Height="8"
                             Visibility="Collapsed"
                             Foreground="#FF8C00"
                             Background="#3C3C3C"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content: canvas + floating preview card -->
        <Grid>
            <controls:GraphCanvas x:Name="NodeGraph"/>

            <Canvas x:Name="FloatCanvas">
                <Border x:Name="FloatCard"
                        Canvas.Left="100" Canvas.Top="60"
                        Width="360" Height="400"
                        MinWidth="200" MinHeight="150"
                        Background="#3C3F41"
                        BorderBrush="#555" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1E1E1E"
                                Padding="6,4"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="FloatHeader_MouseDown"
                                MouseMove="FloatHeader_MouseMove"
                                MouseLeftButtonUp="FloatHeader_MouseUp">
                            <TextBlock Text="PREVIEW"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <controls:PreviewPanel x:Name="FloatPreviewPanel" Grid.Row="1"/>

                        <Thumb Grid.Row="2"
                               Width="14" HorizontalAlignment="Right"
                               Cursor="SizeNWSE"
                               DragDelta="ResizeThumb_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Canvas Width="12" Height="12" Margin="0,1,1,0">
                                        <Line X1="2"  Y1="12" X2="12" Y2="2"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="6"  Y1="12" X2="12" Y2="6"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="10" Y1="12" X2="12" Y2="10" Stroke="#666" StrokeThickness="1.5"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
