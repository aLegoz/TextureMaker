<Window x:Class="TextureMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:controls="clr-namespace:TextureMaker.Views.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="TextureMaker" Height="700" Width="1200"
        Background="#1E1E1E"
        Icon="Resources/TextureMaker.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown"
        FontSize="12"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- Node creation button: icon + label, hover highlight -->
        <Style x:Key="NodeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3C3C42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#515158"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- File panel button: flat text style, like a menu bar item -->
        <Style x:Key="FileMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3C3C42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#515158"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootPanel" Background="#252526">

        <!-- ── File panel ──────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                Padding="4,3">
            <DockPanel>
                <!-- File actions -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FileMenuBtn}" Content="New"      ToolTip="New (Ctrl+N)"  Click="NewProject_Click"/>
                    <Button Style="{StaticResource FileMenuBtn}" Content="Open…"    ToolTip="Open (Ctrl+O)" Click="OpenProject_Click"/>
                    <Button Style="{StaticResource FileMenuBtn}" Content="Save"     ToolTip="Save (Ctrl+S)" Click="SaveProject_Click"/>
                    <Button Style="{StaticResource FileMenuBtn}" Content="Save As…" ToolTip="Save As…"      Click="SaveAsProject_Click"/>
                    <Rectangle Width="1" Height="16" Fill="#3A3A3A" Margin="4,0"/>
                </StackPanel>
                <!-- Current file name -->
                <TextBlock x:Name="FileNameText"
                           Text="New Project"
                           Foreground="#666"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ── Nodes toolbar ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D2D"
                BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                Padding="6,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- ── SOURCES ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="RootFolder" Click="AddNode_Click" ToolTip="Root Folder">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.RootFolder}" Margin="0,0,0,2"/>
                                <TextBlock Text="Folder" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="ImageLoad" Click="AddNode_Click" ToolTip="Image Load">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.ImageLoad}" Margin="0,0,0,2"/>
                                <TextBlock Text="Load" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Color" Click="AddNode_Click" ToolTip="Color">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Color}" Margin="0,0,0,2"/>
                                <TextBlock Text="Color" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="SolidColor" Click="AddNode_Click" ToolTip="Solid Color">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.SolidColor}" Margin="0,0,0,2"/>
                                <TextBlock Text="Solid" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Gradient" Click="AddNode_Click" ToolTip="Gradient">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Gradient}" Margin="0,0,0,2"/>
                                <TextBlock Text="Gradient" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Noise" Click="AddNode_Click" ToolTip="Noise">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Noise}" Margin="0,0,0,2"/>
                                <TextBlock Text="Noise" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="SOURCES" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="34" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── FILTERS ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="Blur" Click="AddNode_Click" ToolTip="Blur">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Blur}" Margin="0,0,0,2"/>
                                <TextBlock Text="Blur" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Sharpen" Click="AddNode_Click" ToolTip="Sharpen">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Sharpen}" Margin="0,0,0,2"/>
                                <TextBlock Text="Sharpen" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="BrightnessContrast" Click="AddNode_Click" ToolTip="Brightness / Contrast">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.BrightnessContrast}" Margin="0,0,0,2"/>
                                <TextBlock Text="B/Contrast" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="FILTERS" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="34" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── COMBINE ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="Blend" Click="AddNode_Click" ToolTip="Blend">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Blend}" Margin="0,0,0,2"/>
                                <TextBlock Text="Blend" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Mask" Click="AddNode_Click" ToolTip="Mask">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Mask}" Margin="0,0,0,2"/>
                                <TextBlock Text="Mask" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Composite" Click="AddNode_Click" ToolTip="Composite">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Composite}" Margin="0,0,0,2"/>
                                <TextBlock Text="Composite" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="COMBINE" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="34" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── SPECIAL ──────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NodeBtn}" Tag="NormalMap" Click="AddNode_Click" ToolTip="Normal Map">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.NormalMap}" Margin="0,0,0,2"/>
                                <TextBlock Text="NormalMap" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Invert" Click="AddNode_Click" ToolTip="Invert">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Invert}" Margin="0,0,0,2"/>
                                <TextBlock Text="Invert" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NodeBtn}" Tag="Levels" Click="AddNode_Click" ToolTip="Levels">
                            <StackPanel Width="56" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{StaticResource Icon.Levels}" Margin="0,0,0,2"/>
                                <TextBlock Text="Levels" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="SPECIAL" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Rectangle Width="1" Height="34" Fill="#3A3A3A" Margin="4,0"/>

                <!-- ── OUTPUT ───────────────────────────────────── -->
                <StackPanel Orientation="Vertical" Margin="4,0">
                    <Button Style="{StaticResource NodeBtn}" Tag="Save" Click="AddNode_Click" ToolTip="Save Texture">
                        <StackPanel Width="56" HorizontalAlignment="Center">
                            <Image Width="26" Height="26" Source="{StaticResource Icon.SaveTexture}" Margin="0,0,0,2"/>
                            <TextBlock Text="Save" FontSize="12" Foreground="#D4D4D4" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="OUTPUT" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="StatusText">Ready — click a node to preview it</TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content: canvas + floating preview card -->
        <Grid>
            <controls:GraphCanvas x:Name="NodeGraph"/>

            <Canvas x:Name="FloatCanvas">
                <Border x:Name="FloatCard"
                        Canvas.Left="100" Canvas.Top="60"
                        Width="360" Height="400"
                        MinWidth="200" MinHeight="150"
                        Background="#3C3F41"
                        BorderBrush="#555" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1E1E1E"
                                Padding="6,4"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="FloatHeader_MouseDown"
                                MouseMove="FloatHeader_MouseMove"
                                MouseLeftButtonUp="FloatHeader_MouseUp">
                            <TextBlock Text="PREVIEW"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <controls:PreviewPanel x:Name="FloatPreviewPanel" Grid.Row="1"/>

                        <Thumb Grid.Row="2"
                               Width="14" HorizontalAlignment="Right"
                               Cursor="SizeNWSE"
                               DragDelta="ResizeThumb_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Canvas Width="12" Height="12" Margin="0,1,1,0">
                                        <Line X1="2"  Y1="12" X2="12" Y2="2"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="6"  Y1="12" X2="12" Y2="6"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="10" Y1="12" X2="12" Y2="10" Stroke="#666" StrokeThickness="1.5"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
