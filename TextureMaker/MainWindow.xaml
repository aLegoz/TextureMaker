<ribbon:RibbonWindow x:Class="TextureMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        xmlns:controls="clr-namespace:TextureMaker.Views.Controls"
        Title="TextureMaker" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">
    <DockPanel>

        <!-- Ribbon -->
        <ribbon:Ribbon DockPanel.Dock="Top">

            <ribbon:Ribbon.QuickAccessToolBar>
                <ribbon:RibbonQuickAccessToolBar>

                    <!-- New -->
                    <ribbon:RibbonButton ToolTip="New (Ctrl+N)" Click="NewProject_Click">
                        <ribbon:RibbonButton.SmallImageSource>
                            <DrawingImage>
                                <DrawingImage.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="White" Geometry="M2,0 L10,0 L14,4 L14,16 L2,16 Z">
                                            <GeometryDrawing.Pen><Pen Brush="#999" Thickness="0.8"/></GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#CCC" Geometry="M10,0 L14,4 L10,4 Z"/>
                                    </DrawingGroup>
                                </DrawingImage.Drawing>
                            </DrawingImage>
                        </ribbon:RibbonButton.SmallImageSource>
                    </ribbon:RibbonButton>

                    <!-- Open -->
                    <ribbon:RibbonButton ToolTip="Open (Ctrl+O)" Click="OpenProject_Click">
                        <ribbon:RibbonButton.SmallImageSource>
                            <DrawingImage>
                                <DrawingImage.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#C8860A" Geometry="M0,5 L0,14 L16,14 L16,5 Z"/>
                                        <GeometryDrawing Brush="#F0A820" Geometry="M0,5 L3,2 L9,2 L9,5 Z"/>
                                        <GeometryDrawing Brush="#F5C040" Geometry="M1,6 L15,6 L13,13 L1,13 Z"/>
                                    </DrawingGroup>
                                </DrawingImage.Drawing>
                            </DrawingImage>
                        </ribbon:RibbonButton.SmallImageSource>
                    </ribbon:RibbonButton>

                    <!-- Save -->
                    <ribbon:RibbonButton ToolTip="Save (Ctrl+S)" Click="SaveProject_Click">
                        <ribbon:RibbonButton.SmallImageSource>
                            <DrawingImage>
                                <DrawingImage.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#4A90D9" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                                        <GeometryDrawing Brush="White"   Geometry="M2,9 L14,9 L14,15 L2,15 Z"/>
                                        <GeometryDrawing Brush="#DDE"    Geometry="M3,0 L11,0 L11,6 L3,6 Z"/>
                                        <GeometryDrawing Brush="#88A"    Geometry="M8,1 L10,1 L10,5 L8,5 Z"/>
                                    </DrawingGroup>
                                </DrawingImage.Drawing>
                            </DrawingImage>
                        </ribbon:RibbonButton.SmallImageSource>
                    </ribbon:RibbonButton>

                </ribbon:RibbonQuickAccessToolBar>
            </ribbon:Ribbon.QuickAccessToolBar>
            <ribbon:Ribbon.ApplicationMenu>
                <ribbon:RibbonApplicationMenu>
                    <ribbon:RibbonApplicationMenuItem Header="New"      Click="NewProject_Click"   InputGestureText="Ctrl+N"/>
                    <ribbon:RibbonApplicationMenuItem Header="Open..."  Click="OpenProject_Click"  InputGestureText="Ctrl+O"/>
                    <ribbon:RibbonApplicationMenuItem Header="Save"     Click="SaveProject_Click"  InputGestureText="Ctrl+S"/>
                    <ribbon:RibbonApplicationMenuItem Header="Save As..." Click="SaveAsProject_Click"/>
                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>

            <ribbon:RibbonTab Header="Nodes">

                <ribbon:RibbonGroup Header="Sources">
                    <ribbon:RibbonButton Label="Root Folder"  Click="AddNode_Click" Tag="RootFolder"/>
                    <ribbon:RibbonButton Label="Image Load"   Click="AddNode_Click" Tag="ImageLoad"/>
                    <ribbon:RibbonButton Label="Solid Color"  Click="AddNode_Click" Tag="SolidColor"/>
                    <ribbon:RibbonButton Label="Gradient"     Click="AddNode_Click" Tag="Gradient"/>
                    <ribbon:RibbonButton Label="Noise"        Click="AddNode_Click" Tag="Noise"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Filters">
                    <ribbon:RibbonButton Label="Blur"                 Click="AddNode_Click" Tag="Blur"/>
                    <ribbon:RibbonButton Label="Sharpen"              Click="AddNode_Click" Tag="Sharpen"/>
                    <ribbon:RibbonButton Label="Brightness / Contrast" Click="AddNode_Click" Tag="BrightnessContrast"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Combine">
                    <ribbon:RibbonButton Label="Blend"     Click="AddNode_Click" Tag="Blend"/>
                    <ribbon:RibbonButton Label="Mask"      Click="AddNode_Click" Tag="Mask"/>
                    <ribbon:RibbonButton Label="Composite" Click="AddNode_Click" Tag="Composite"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Special">
                    <ribbon:RibbonButton Label="Normal Map" Click="AddNode_Click" Tag="NormalMap"/>
                    <ribbon:RibbonButton Label="Invert"     Click="AddNode_Click" Tag="Invert"/>
                    <ribbon:RibbonButton Label="Levels"     Click="AddNode_Click" Tag="Levels"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Output">
                    <ribbon:RibbonButton Label="Save Texture" Click="AddNode_Click" Tag="Save"/>
                </ribbon:RibbonGroup>

            </ribbon:RibbonTab>
        </ribbon:Ribbon>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="StatusText">Ready — click a node to preview it</TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content: full-width canvas + floating preview card -->
        <Grid>
            <controls:GraphCanvas x:Name="NodeGraph"/>

            <Canvas x:Name="FloatCanvas">
                <Border x:Name="FloatCard"
                        Canvas.Left="100" Canvas.Top="60"
                        Width="360" Height="400"
                        MinWidth="200" MinHeight="150"
                        Background="#3C3F41"
                        BorderBrush="#555" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1E1E1E"
                                Padding="6,4"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="FloatHeader_MouseDown"
                                MouseMove="FloatHeader_MouseMove"
                                MouseLeftButtonUp="FloatHeader_MouseUp">
                            <TextBlock Text="PREVIEW"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <controls:PreviewPanel x:Name="FloatPreviewPanel" Grid.Row="1"/>

                        <Thumb Grid.Row="2"
                               Width="14" HorizontalAlignment="Right"
                               Cursor="SizeNWSE"
                               DragDelta="ResizeThumb_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Canvas Width="12" Height="12" Margin="0,1,1,0">
                                        <Line X1="2"  Y1="12" X2="12" Y2="2"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="6"  Y1="12" X2="12" Y2="6"  Stroke="#666" StrokeThickness="1.5"/>
                                        <Line X1="10" Y1="12" X2="12" Y2="10" Stroke="#666" StrokeThickness="1.5"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</ribbon:RibbonWindow>
