<Window x:Class="TextureMaker.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="Transparent" AllowsTransparency="True"
        KeyDown="Window_KeyDown">

    <Border Background="#2D2D30" BorderBrush="#555" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="6,6,0,0"
                    Padding="12,8" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="#FF8C00"
                            CornerRadius="2,0,0,2" Margin="-12,-8,-1,-8"/>
                    <TextBlock x:Name="TitleText" Foreground="#E8E8E8" FontSize="13"
                               FontWeight="SemiBold" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Message -->
            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Foreground="#CCCCCC" FontSize="12"
                       Margin="22,14,22,14" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="#252526" CornerRadius="0,0,6,6" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnYes" Width="72" Margin="0,0,6,0" Click="Yes_Click">
                        <TextBlock Text="Delete" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#C42B1C"/>
                                <Setter Property="BorderBrush" Value="#A02010"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="0,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E03020"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#801808"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnCancel" Width="72" Click="Cancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#D4D4D4"/>
                                <Setter Property="BorderBrush" Value="#555"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="0,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Content" Value="Cancel"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#777"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
