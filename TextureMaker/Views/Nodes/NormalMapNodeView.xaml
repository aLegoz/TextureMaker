<UserControl x:Class="TextureMaker.Views.Nodes.NormalMapNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4" Orientation="Horizontal">
        <TextBlock Text="Strength:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCC"/>
        <Slider Width="80" Minimum="0.1" Maximum="10" Value="{Binding Strength}" Margin="0,0,4,0"/>
        <TextBlock Text="{Binding Strength, StringFormat=F1}" VerticalAlignment="Center" Foreground="#CCC"/>
    </StackPanel>
</UserControl>
