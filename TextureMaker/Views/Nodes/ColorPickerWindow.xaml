<Window x:Class="TextureMaker.Views.Nodes.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Picker" Width="450" Height="490"
        Background="#1C1C1C" Foreground="White"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#CCC">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#888">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,4,4"/>
                                <RectangleGeometry Rect="4,4,4,4"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Width" Value="46"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="-1,0,4,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <!-- ── Top: SV field + Hue / Alpha / Preview ──────────────── -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Saturation-Value canvas -->
            <Border Grid.Column="0" BorderBrush="#555" BorderThickness="1">
                <Canvas Name="SvCanvas" Width="200" Height="200" ClipToBounds="True"
                        Cursor="Cross"
                        MouseLeftButtonDown="SvCanvas_MouseDown"
                        MouseMove="SvCanvas_MouseMove"
                        MouseLeftButtonUp="SvCanvas_MouseUp">
                    <!-- Base: white → hue (set from code) -->
                    <Rectangle Name="SvHueBg" Width="200" Height="200"/>
                    <!-- Overlay: transparent → black -->
                    <Rectangle Width="200" Height="200" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Thumb -->
                    <Ellipse Name="SvThumb" Width="14" Height="14"
                             Stroke="White" StrokeThickness="2" Fill="Transparent"
                             IsHitTestVisible="False"/>
                </Canvas>
            </Border>

            <!-- Right panel -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">

                <!-- Hue bar -->
                <TextBlock Text="Hue" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                <Border BorderBrush="#555" BorderThickness="1" CornerRadius="2"
                        Height="20" Margin="0,0,0,8" ClipToBounds="True">
                    <Grid Name="HueBar" Cursor="Cross"
                          MouseLeftButtonDown="HueBar_MouseDown"
                          MouseMove="HueBar_MouseMove"
                          MouseLeftButtonUp="HueBar_MouseUp">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Name="HueThumb" Width="4" HorizontalAlignment="Left"
                                   Fill="White" Stroke="#222" StrokeThickness="1"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Alpha bar -->
                <TextBlock Text="Alpha" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                <Border BorderBrush="#555" BorderThickness="1" CornerRadius="2"
                        Height="20" Margin="0,0,0,10" ClipToBounds="True">
                    <Grid Name="AlphaBar" Cursor="Cross"
                          MouseLeftButtonDown="AlphaBar_MouseDown"
                          MouseMove="AlphaBar_MouseMove"
                          MouseLeftButtonUp="AlphaBar_MouseUp">
                        <Rectangle Fill="{StaticResource CheckerBrush}"/>
                        <Rectangle Name="AlphaGradRect" IsHitTestVisible="False"/>
                        <Rectangle Name="AlphaThumb" Width="4" HorizontalAlignment="Left"
                                   Fill="White" Stroke="#222" StrokeThickness="1"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Old / New preview -->
                <TextBlock Text="Color" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                <Grid Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2,0,0,2"
                            BorderBrush="#555" BorderThickness="1,1,0,1" ClipToBounds="True">
                        <Grid>
                            <Rectangle Fill="{StaticResource CheckerBrush}"/>
                            <Rectangle Name="OldColorRect"/>
                            <TextBlock Text="old" Foreground="#AAA" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="0,2,2,0"
                            BorderBrush="#555" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Rectangle Fill="{StaticResource CheckerBrush}"/>
                            <Rectangle Name="NewColorRect"/>
                            <TextBlock Text="new" Foreground="#AAA" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </Grid>

        <!-- ── Input fields ────────────────────────────────────────── -->
        <Border Background="#252525" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- HEX -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="HEX"
                           Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="TxtHex"
                         FontFamily="Consolas" FontSize="12"
                         Background="#1A1A1A" Foreground="#DDD" BorderBrush="#444"
                         Padding="4,1" VerticalAlignment="Center"
                         PreviewKeyDown="Txt_KeyDown" LostFocus="TxtHex_Commit"
                         PreviewTextInput="HexBox_PreviewInput"
                         MaxLength="9"/>

                <!-- RGBA -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="RGBA"
                           Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Name="TxtRgbR" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="RgbaCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBox Name="TxtRgbG" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="RgbaCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBox Name="TxtRgbB" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="RgbaCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBox Name="TxtRgbA" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="RgbaCommit" PreviewTextInput="NumBox_PreviewInput"/>
                </StackPanel>

                <!-- HSV -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="HSV"
                           Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Name="TxtHsvH" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="HsvCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="°"/>
                    <TextBox Name="TxtHsvS" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="HsvCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="%"/>
                    <TextBox Name="TxtHsvV" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="HsvCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="%"/>
                </StackPanel>

                <!-- HSL -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="HSL"
                           Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Name="TxtHslH" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="HslCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="°"/>
                    <TextBox Name="TxtHslS" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="HslCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="%"/>
                    <TextBox Name="TxtHslL" Style="{StaticResource NumBox}" MaxLength="3"
                             PreviewKeyDown="Txt_KeyDown" LostFocus="HslCommit" PreviewTextInput="NumBox_PreviewInput"/>
                    <TextBlock Style="{StaticResource UnitLabel}" Text="%"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── OK / Cancel ─────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="70" Margin="0,0,8,0" IsDefault="True" Click="OK_Click"/>
            <Button Content="Cancel" Width="70" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
