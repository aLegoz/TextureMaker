<UserControl x:Class="TextureMaker.Views.Nodes.BrightnessContrastNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="35"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Brightness:" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="#CCC"/>
        <Slider Grid.Row="0" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Brightness}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Brightness, StringFormat=F2}" VerticalAlignment="Center" Margin="4,0,0,4" Foreground="#CCC"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Contrast:" VerticalAlignment="Center" Foreground="#CCC"/>
        <Slider Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Contrast}"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Contrast, StringFormat=F2}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#CCC"/>
    </Grid>
</UserControl>
