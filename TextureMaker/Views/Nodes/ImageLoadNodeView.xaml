<UserControl x:Class="TextureMaker.Views.Nodes.ImageLoadNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4" MinWidth="180">
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBox Name="PathBox" Width="130"
                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="File path (relative if root folder connected)"/>
            <Button Content="…" Width="26" Margin="4,0,0,0" Click="Browse_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
