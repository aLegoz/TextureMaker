<UserControl x:Class="TextureMaker.Views.Nodes.ImageLoadNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4,2">
        <Button DockPanel.Dock="Right" Content="…" Width="26" Margin="4,0,0,0"
                Click="Browse_Click" ToolTip="Browse image file"/>
        <TextBox x:Name="PathBox"
                 Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="File path (relative if root folder connected)"/>
    </DockPanel>
</UserControl>
