<UserControl x:Class="TextureMaker.Views.Nodes.BlurNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4" Orientation="Horizontal">
        <TextBlock Text="Sigma:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCC"/>
        <Slider Width="90" Minimum="0.1" Maximum="20" Value="{Binding Sigma}" Margin="0,0,4,0"/>
        <TextBlock Text="{Binding Sigma, StringFormat=F1}" VerticalAlignment="Center" Foreground="#CCC"/>
    </StackPanel>
</UserControl>
