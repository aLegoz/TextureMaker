<UserControl x:Class="TextureMaker.Views.Nodes.NoiseNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Scale:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="20" Value="{Binding Scale}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Octaves:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="8" Value="{Binding Octaves}"
                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                 Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="W:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                 Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="H:" VerticalAlignment="Center" Foreground="#CCC"/>
        <TextBox Grid.Row="4" Grid.Column="1"
                 Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
