<UserControl x:Class="TextureMaker.Views.Nodes.SaveNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4" MinWidth="180">
        <!-- Filename field (relative if root connected, absolute otherwise) -->
        <TextBox Margin="0,4,0,2"
                 Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Filename (e.g. output.png); relative if root folder connected"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Save" Width="54" Margin="0,0,4,0" Click="Save_Click"
                    ToolTip="Save to root + filename"/>
            <Button Content="Save As…" Click="SaveAs_Click"
                    ToolTip="Choose save path via dialog"/>
        </StackPanel>
    </StackPanel>
</UserControl>
