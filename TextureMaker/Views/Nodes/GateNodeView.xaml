<UserControl x:Class="TextureMaker.Views.Nodes.GateNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4,2">
        <Grid>
            <CheckBox Content="Allow" IsChecked="{Binding IsActive}" Margin="0,2"/>
            <Border Margin="-4,0,-4,2" Background="#CC141414" CornerRadius="3"
                    Visibility="{Binding ConditionPin.ViewModel.IsConnected, Converter={StaticResource BoolToVis}}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="13"
                           Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
