<UserControl x:Class="TextureMaker.Views.Nodes.GradientNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:src="clr-namespace:TextureMaker.Nodes.Sources">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Direction:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                  ItemsSource="{Binding Source={x:Static src:GradientDirectionValues.All}}"
                  SelectedItem="{Binding Direction}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Color A:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <Border Grid.Row="1" Grid.Column="1" Height="20" Margin="0,0,0,4"
                BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                MouseLeftButtonDown="ColorA_Click">
            <Border.Background><SolidColorBrush Color="{Binding ColorA}"/></Border.Background>
        </Border>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Color B:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <Border Grid.Row="2" Grid.Column="1" Height="20" Margin="0,0,0,4"
                BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                MouseLeftButtonDown="ColorB_Click">
            <Border.Background><SolidColorBrush Color="{Binding ColorB}"/></Border.Background>
        </Border>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="W:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#CCC"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                 Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="H:" VerticalAlignment="Center" Foreground="#CCC"/>
        <TextBox Grid.Row="4" Grid.Column="1"
                 Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
