<Window x:Class="TextureMaker.Views.Controls.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TextureMaker.Views.Controls"
        Title="Preview" Width="400" Height="420"
        FontFamily="Segoe UI" FontSize="12"
        MinWidth="200" MinHeight="200"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#3C3F41"
        ShowInTaskbar="False">
    <Border BorderBrush="#555" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Node-style header (drag to move) -->
            <Border Grid.Row="0"
                    Background="#1E1E1E"
                    Padding="6,4"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <TextBlock Text="PREVIEW"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Dock"
                                Click="DockButton_Click"
                                Background="Transparent"
                                Foreground="#888"
                                BorderThickness="0"
                                FontSize="12"
                                Padding="6,0"
                                Cursor="Arrow"/>
                        <Button Content="×"
                                Click="CloseButton_Click"
                                Background="Transparent"
                                Foreground="#888"
                                BorderThickness="0"
                                FontSize="14"
                                Padding="4,0"
                                Cursor="Arrow"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview content -->
            <controls:PreviewPanel x:Name="PreviewPanel" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
