<Window x:Class="TextureMaker.Views.Controls.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TextureMaker.Views.Controls"
        Title="Preview" Width="400" Height="420"
        MinWidth="200" MinHeight="200"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="6,3">
            <DockPanel>
                <TextBlock Text="Preview" Foreground="#AAA" VerticalAlignment="Center"/>
                <Button x:Name="DockButton" DockPanel.Dock="Right"
                        Content="Dock" Click="DockButton_Click"
                        Padding="10,2" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <controls:PreviewPanel x:Name="PreviewPanel"/>
    </DockPanel>
</Window>
