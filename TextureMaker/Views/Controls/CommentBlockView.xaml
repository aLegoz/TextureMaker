<UserControl x:Class="TextureMaker.Views.Controls.CommentBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml">
    <Border x:Name="RootBorder"
            BorderBrush="#555" BorderThickness="1"
            CornerRadius="6"
            MinWidth="180" MinHeight="100">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" x:Name="HeaderBorder"
                    CornerRadius="6,6,0,0" Padding="6,5"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseDown">
                <DockPanel>
                    <!-- Color swatch -->
                    <Border x:Name="ColorSwatch"
                            DockPanel.Dock="Left"
                            Width="14" Height="14" CornerRadius="3"
                            Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonDown="ColorSwatch_Click"/>

                    <!-- Title -->
                    <TextBox x:Name="TitleBox"
                             DockPanel.Dock="Left"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E8E8E8" FontSize="12" FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Cursor="IBeam"/>

                    <!-- Preview toggle -->
                    <Button DockPanel.Dock="Right"
                            x:Name="PreviewBtn"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#AAA" FontSize="11"
                            Padding="4,0" Cursor="Hand"
                            ToolTip="Toggle preview"
                            Click="Preview_Click">
                        <TextBlock Text="&#x2B1B;" Foreground="#AAA" FontSize="11"/>
                    </Button>

                    <!-- Delete -->
                    <Button DockPanel.Dock="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#888" FontSize="14"
                            Padding="4,0" Cursor="Hand"
                            Click="Delete_Click">
                        <TextBlock Text="&#xD7;" Foreground="#888" FontSize="15"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Body: edit mode -->
            <TextBox Grid.Row="1"
                     x:Name="BodyEdit"
                     Background="#1E1E22"
                     Foreground="#CCCCCC"
                     BorderThickness="0"
                     Padding="10,8"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="Visible"/>

            <!-- Body: preview mode -->
            <ScrollViewer Grid.Row="1"
                          x:Name="BodyPreview"
                          Background="#1E1E22"
                          Padding="10,8"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <mdxaml:MarkdownScrollViewer x:Name="MdViewer"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              VerticalScrollBarVisibility="Disabled"/>
            </ScrollViewer>

            <!-- Resize thumb -->
            <Thumb Grid.Row="2"
                   HorizontalAlignment="Right"
                   Width="14" Cursor="SizeNWSE"
                   DragDelta="Resize_DragDelta">
                <Thumb.Template>
                    <ControlTemplate>
                        <Canvas Width="12" Height="12" Margin="0,1,1,0">
                            <Line X1="2" Y1="12" X2="12" Y2="2" Stroke="#555" StrokeThickness="1.5"/>
                            <Line X1="6" Y1="12" X2="12" Y2="6" Stroke="#555" StrokeThickness="1.5"/>
                            <Line X1="10" Y1="12" X2="12" Y2="10" Stroke="#555" StrokeThickness="1.5"/>
                        </Canvas>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
