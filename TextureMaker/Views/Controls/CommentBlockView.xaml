<UserControl x:Class="TextureMaker.Views.Controls.CommentBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml">
    <Border x:Name="RootBorder"
            BorderBrush="#555" BorderThickness="1"
            CornerRadius="6"
            MinWidth="180" MinHeight="100">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: Header          -->
                <RowDefinition Height="*"/>      <!-- 1: Body            -->
                <RowDefinition Height="Auto"/>   <!-- 2: Color palette   -->
                <RowDefinition Height="14"/>     <!-- 3: Resize thumb    -->
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────────── -->
            <Border Grid.Row="0" x:Name="HeaderBorder"
                    CornerRadius="6,6,0,0"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <!-- Edit/Preview toggle (Border avoids Button/Header capture conflict) -->
                    <Border Grid.Column="0" x:Name="EditToggleBorder"
                            CornerRadius="5,0,0,0"
                            Cursor="Hand" ToolTip="Toggle preview"
                            MouseLeftButtonDown="EditToggle_MouseDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#30FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="EditToggleIcon"
                                   Text="&#x2713;" FontSize="13" Foreground="#4CAF50"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Border>

                    <!-- Title — IsHitTestVisible toggled by ApplyMode() -->
                    <TextBox Grid.Column="1" x:Name="TitleBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E8E8E8" FontSize="12" FontWeight="SemiBold"
                             VerticalAlignment="Center" Padding="4,0"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Cursor="IBeam"/>

                    <!-- Delete -->
                    <Button Grid.Column="2" x:Name="DeleteBtn"
                            Click="Delete_Click"
                            Cursor="Hand" Padding="0"
                            ToolTip="Delete">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="0,5,0,0">
                                    <TextBlock x:Name="Ico"
                                               Text="&#xD7;" Foreground="#888" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                        <Setter TargetName="Ico" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Body: edit ─────────────────────────────────────────── -->
            <TextBox Grid.Row="1" x:Name="BodyEdit"
                     Background="#1E1E22" Foreground="#CCCCCC"
                     BorderThickness="0" Padding="10,8"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="Visible"/>

            <!-- ── Body: preview ──────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" x:Name="BodyPreview"
                          Background="#1E1E22" Padding="10,8"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <!-- IsHitTestVisible=False prevents text selection while keeping
                     the scrollbar (part of ScrollViewer template) fully functional -->
                <mdxaml:MarkdownScrollViewer x:Name="MdViewer"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              IsHitTestVisible="False"
                                              VerticalScrollBarVisibility="Disabled"/>
            </ScrollViewer>

            <!-- ── Color palette — below body so it doesn't shift the body top ── -->
            <Border Grid.Row="2" x:Name="ColorRow"
                    Background="#18181C" Padding="6,4"
                    Visibility="Visible">
                <StackPanel x:Name="ColorPalette" Orientation="Horizontal"/>
            </Border>

            <!-- ── Resize thumb ───────────────────────────────────────── -->
            <Thumb Grid.Row="3"
                   HorizontalAlignment="Right"
                   Width="14" Cursor="SizeNWSE"
                   DragDelta="Resize_DragDelta">
                <Thumb.Template>
                    <ControlTemplate>
                        <Canvas Width="12" Height="12" Margin="0,1,1,0">
                            <Line X1="2"  Y1="12" X2="12" Y2="2"  Stroke="#555" StrokeThickness="1.5"/>
                            <Line X1="6"  Y1="12" X2="12" Y2="6"  Stroke="#555" StrokeThickness="1.5"/>
                            <Line X1="10" Y1="12" X2="12" Y2="10" Stroke="#555" StrokeThickness="1.5"/>
                        </Canvas>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
