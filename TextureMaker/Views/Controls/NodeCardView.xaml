<UserControl x:Class="TextureMaker.Views.Controls.NodeCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Name="CardBorder"
            Background="#3C3F41"
            BorderThickness="1"
            CornerRadius="4"
            MinWidth="160"
            Effect="{x:Null}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#555"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#FF8C00"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="BorderBrush" Value="#CC2222"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <!-- Header (drag handle) -->
            <Border Name="Header"
                    Background="#1E1E1E"
                    CornerRadius="4,4,0,0"
                    Padding="6,3"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseDown"
                    MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseUp">
                <Grid>
                    <TextBlock Text="{Binding Name}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <Button Content="×"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Padding="4,0"
                            Background="Transparent"
                            Foreground="#888"
                            BorderThickness="0"
                            Cursor="Arrow"
                            Click="Delete_Click"/>
                </Grid>
            </Border>

            <!-- Pins row (input sockets on the left, output on right) -->
            <Grid Name="PinsGrid" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Name="InputPinsPanel" Grid.Column="0"/>
                <StackPanel Name="OutputPinsPanel" Grid.Column="1" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Custom content — DataTemplate lookup via DataContext -->
            <ContentPresenter Content="{Binding}" Margin="4,0,4,4"/>

            <!-- Thumbnail preview -->
            <Border x:Name="ThumbBorder"
                    Background="#111" Margin="4,0,4,4"
                    Visibility="Collapsed">
                <Image x:Name="ThumbImage"
                       MaxHeight="90" Stretch="Uniform"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
