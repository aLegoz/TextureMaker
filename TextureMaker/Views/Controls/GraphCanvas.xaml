<UserControl x:Class="TextureMaker.Views.Controls.GraphCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2B2B2B"
             ClipToBounds="True">
    <Grid x:Name="RootGrid">
        <!-- Connections layer (drawn first, behind nodes) -->
        <Canvas Name="ConnectionCanvas" IsHitTestVisible="False"/>

        <!-- Nodes layer -->
        <Canvas Name="NodeCanvas"/>

        <!-- Drag-connection overlay (temp bezier while drawing) -->
        <!-- IsHitTestVisible toggled in code-behind during drag -->
        <Canvas Name="DragCanvas" IsHitTestVisible="False" Background="Transparent">
            <Path Name="DragPath" StrokeThickness="2" Visibility="Collapsed">
                <Path.Data>
                    <PathGeometry/>
                </Path.Data>
            </Path>
        </Canvas>
    </Grid>
</UserControl>
